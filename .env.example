# Copy to .env and replace every value. Do not commit .env.
# Production refuses the example values below; see docs/DEPLOY.md for the production list.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

POSTGRES_PASSWORD=change-me
SECRET_ENCRYPTION_KEY=replace-with-fernet-key
# Key rotation: put the old key here, restart, run `python -m app.rotate_keys`, then empty it and restart.
# SECRET_ENCRYPTION_KEY_PREVIOUS=
SESSION_SIGNING_KEY=replace-with-long-random-string
ADMIN_INITIAL_EMAIL=admin@localhost
ADMIN_INITIAL_PASSWORD=ChangeMe-Now-12
YOUR_APP_API_KEY=dev-your-app-key
YOUR_APP_DELEGATION_SECRET=dev-delegation-secret

# Local process (not Compose). SQLite is enough for development.
# ENVIRONMENT=dev
# DATABASE_URL=sqlite+pysqlite:///./hub.db
# COOKIE_SECURE=false
# ALLOW_INSECURE_HTTP=true
# EGRESS_ALLOW_LOOPBACK=true
# EGRESS_ALLOWED_PORTS=80,443,8080,8081
# EGRESS_ALLOWED_HOSTS=localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
# MCP_ISSUER_URL=http://127.0.0.1:8000

# Production requires PostgreSQL, secure cookies, HTTPS and an approved
# EGRESS_ALLOWED_HOSTS or EGRESS_ALLOWED_CIDRS list; private/loopback egress is denied.
# MFA_REQUIRED=true is recommended there; false lets admins sign in with the password alone.
# MFA_ENROLL_HOURS=72             # hours a new or reset admin has to set up MFA; then a super admin resets it
# Behind a reverse proxy, uvicorn trusts X-Forwarded-For only from these addresses (the proxy), so
# login limits see real clients. The backend image passes it to --forwarded-allow-ips.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Limits (defaults shown). Counters are per process: run one worker.
# TOOL_RATE_LIMIT=60
# TOOL_RATE_WINDOW_SECONDS=60
# TOOL_CONCURRENCY=8
# CONNECTOR_CONCURRENCY=8
# REPORT_MAX_RECORDS=1000        # records run_report may read per call (50-5000)
# REPORT_TIMEOUT_SECONDS=20      # then it answers with partial coverage
# AUDIT_RETENTION_DAYS=90
# PURGE_INTERVAL_HOURS=6          # automatic purge of expired audit rows, sessions and memories; 0 = off

# Hub chat (the AI chat apps embed). Keys stay on the Hub; apps and browsers never see them.
# Model keys are set in the admin UI under AI providers (stored encrypted, no restart needed).
# ANTHROPIC_API_KEY is only a fallback for the Claude key when none is saved there.
# ANTHROPIC_API_KEY=
# OpenAI-compatible providers (OpenAI, OpenRouter, Groq, Gemini, Ollama, ...) are added in the admin UI
# under AI providers, with their keys stored encrypted. Where they may live:
# MODEL_EGRESS_ALLOWED_HOSTS=            # empty: any public host
# MODEL_EGRESS_ALLOWED_PORTS=443,80,11434,1234
# Older setups: one gateway from the environment, shown as "Gateway (environment)".
# CHAT_OPENAI_BASE_URL=https://gateway.example.com/v1
# CHAT_OPENAI_API_KEY=
# CHAT_MAX_TOKENS=16000
# CHAT_TIMEOUT_SECONDS=120
# CHAT_RATE_LIMIT=20
# GATEWAY_APP_RATE_LIMIT=300        # model gateway calls per app per minute, across all its users
# Allowed models and a monthly token budget per app are set in the admin UI (the app's Chat tab).

# The console Assistant answers admins from this repository (README, docs, code), read-only.
# Empty: the repository the backend runs from. In a container, mount the checkout and point here.
# ASSISTANT_REPO_PATH=/repo
