{
    "name": "mcp-hub/laravel-connector",
    "description": "Application-owned Laravel connectors and a scoped client for MCP Hub.",
    "type": "library",
    "require": {
        "php": "^8.0.2",
        "illuminate/console": "^9.0 || ^12.0",
        "illuminate/contracts": "^9.0 || ^12.0",
        "illuminate/database": "^9.0 || ^12.0",
        "illuminate/http": "^9.0 || ^12.0",
        "illuminate/support": "^9.0 || ^12.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "McpHub\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["McpHub\\Laravel\\McpHubServiceProvider"]
        }
    }
}
