{
  "name": "mcp-hub",
  "version": "1.0.0",
  "private": true,
  "description": "MCP Hub, JavaScript edition: admin UI, Hub API, MCP and chat endpoints in one Nuxt app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "migrate": "node scripts/migrate.js",
    "bootstrap": "node scripts/bootstrap.js",
    "typecheck": "nuxt typecheck",
    "test": "node --test \"test/*.test.js\"",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "ipaddr.js": "^2.5.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.4.21",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.0.7"
  }
}
