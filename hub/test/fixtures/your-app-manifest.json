{
  "contract_version": "1.0",
  "application": "your_app",
  "manifest_version": "2026-10-10.3",
  "modules": [
    {
      "key": "projects",
      "name": "Projects",
      "description": "Projects the signed-in user may see",
      "schema_version": "1.0",
      "supported_operations": [
        "read",
        "create",
        "update"
      ],
      "readable_fields": [
        "ref",
        "name",
        "status",
        "created_at",
        "budget"
      ],
      "writable_fields": [
        "name",
        "status"
      ],
      "filters": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending",
            "completed"
          ]
        }
      },
      "max_page_size": 50,
      "risk": {
        "read": "low",
        "create": "medium"
      },
      "field_policies": {
        "owner_email": "blocked",
        "owner_phone": "blocked",
        "budget": "aggregate_only"
      },
      "read_endpoints": [
        {
          "method": "GET",
          "path_template": "/api/v1/projects",
          "requires_user_context": true,
          "tenant_field": "tenant_id",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "pending",
                  "completed"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "cursor": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "output_schema": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "maxLength": 120
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "pending",
                    "completed"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "maxLength": 64
                },
                "budget": {
                  "type": "number"
                }
              },
              "required": [
                "ref",
                "name",
                "status",
                "created_at",
                "budget"
              ]
            }
          }
        }
      ],
      "write_endpoints": [
        {
          "operation": "create",
          "method": "POST",
          "path_template": "/api/v1/projects",
          "requires_user_context": true,
          "tenant_field": "tenant_id",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "pending"
                ]
              }
            }
          },
          "output_schema": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "proposal_ref",
                "summary",
                "status"
              ],
              "properties": {
                "proposal_ref": {
                  "type": "string",
                  "maxLength": 64
                },
                "summary": {
                  "type": "string",
                  "maxLength": 300
                },
                "status": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            }
          }
        }
      ]
    },
    {
      "key": "activity",
      "name": "User activity",
      "description": "Last activity time of users in the tenant",
      "schema_version": "1.0",
      "supported_operations": [
        "read"
      ],
      "readable_fields": [
        "last_active_at",
        "status"
      ],
      "max_page_size": 50,
      "read_endpoints": [
        {
          "method": "GET",
          "path_template": "/api/v1/activity",
          "requires_user_context": true,
          "tenant_field": "tenant_id",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "output_schema": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "last_active_at",
                "status"
              ],
              "properties": {
                "last_active_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "suspended"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  ]
}
