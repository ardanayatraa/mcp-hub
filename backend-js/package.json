{
  "name": "@mcp-hub/backend-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node.js backend for MCP Hub with an application integration SDK",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
