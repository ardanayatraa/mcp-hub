FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY hub/package.json hub/package-lock.json ./
# Install scripts are not needed: argon2 ships prebuilt binaries and `nuxt build` prepares itself.
RUN npm ci --ignore-scripts
COPY hub/ ./
RUN npm run build

# .output is self-contained: the server bundle plus only the packages it loads.
FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /src/.output ./.output
RUN chown node:node /app
USER node
# Create or upgrade the schema and the first admin on start, like the Python image.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 HUB_AUTO_MIGRATE=true
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
